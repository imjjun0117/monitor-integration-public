<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://java.sun.com/xml/ns/javaee" version="2.5">
  <servlet>
    <servlet-name>monitor</servlet-name>
    <servlet-class>com.hermes.monitoring.agent.servlet.MonitorServlet</servlet-class>
    <init-param>
      <param-name>configurerClass</param-name>
      <param-value>com.hermes.monitoring.testapp.TestConfigurer</param-value>
    </init-param>
    <load-on-startup>1</load-on-startup>
  </servlet>
  <servlet-mapping>
    <servlet-name>monitor</servlet-name>
    <url-pattern>/monitor/v1/*</url-pattern>
  </servlet-mapping>
</web-app>
