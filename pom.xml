<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.hermes.monitoring</groupId>
  <artifactId>hermes-monitoring</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <modules>
    <module>monitor-agent</module>
    <module>monitor-agent-testapp</module>
    <module>monitor-center</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <cyclonedx-maven-plugin.version>2.9.3</cyclonedx-maven-plugin.version>
    <dependency-check.version>12.2.2</dependency-check.version>
  </properties>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.14.1</version>
          <dependencies>
            <dependency>
              <groupId>org.codehaus.plexus</groupId>
              <artifactId>plexus-compiler-eclipse</artifactId>
              <version>2.15.0</version>
            </dependency>
          </dependencies>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>license-maven-plugin</artifactId>
        <version>2.7.0</version>
        <inherited>false</inherited>
        <executions>
          <execution>
            <id>third-party-license-audit</id>
            <phase>verify</phase>
            <goals>
              <goal>aggregate-add-third-party</goal>
            </goals>
            <configuration>
              <failOnMissing>true</failOnMissing>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.cyclonedx</groupId>
        <artifactId>cyclonedx-maven-plugin</artifactId>
        <version>${cyclonedx-maven-plugin.version}</version>
        <inherited>false</inherited>
        <executions>
          <execution>
            <id>production-dependency-sbom</id>
            <phase>package</phase>
            <goals>
              <goal>makeAggregateBom</goal>
            </goals>
            <configuration>
              <includeTestScope>false</includeTestScope>
              <outputFormat>json</outputFormat>
              <outputName>bom</outputName>
              <outputReactorProjects>false</outputReactorProjects>
              <skipAttach>true</skipAttach>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>periodic-owasp</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.owasp</groupId>
            <artifactId>dependency-check-maven</artifactId>
            <version>${dependency-check.version}</version>
            <inherited>false</inherited>
            <executions>
              <execution>
                <id>periodic-nvd-defense-in-depth</id>
                <phase>verify</phase>
                <goals>
                  <goal>aggregate</goal>
                </goals>
                <configuration>
                  <failBuildOnCVSS>7.0</failBuildOnCVSS>
                  <failOnError>true</failOnError>
                  <formats>
                    <format>HTML</format>
                    <format>JSON</format>
                  </formats>
                  <dataDirectory>${user.home}/.cache/hermes-dependency-check</dataDirectory>
                  <nvdApiKeyEnvironmentVariable>NVD_API_KEY</nvdApiKeyEnvironmentVariable>
                  <nvdApiDelay>8000</nvdApiDelay>
                  <nvdMaxRetryCount>10</nvdMaxRetryCount>
                  <nvdValidForHours>24</nvdValidForHours>
                  <ossIndexAnalyzerEnabled>false</ossIndexAnalyzerEnabled>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
