{
  "name": "monitoring-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "generate:api": "node scripts/generate-api.mjs",
    "generate:api:check": "node scripts/generate-api.mjs --check",
    "validate:openapi": "redocly lint ../../contracts/center-api.openapi.yaml",
    "license:check": "node ../../tools/check-npm-licenses.mjs",
    "predev": "node scripts/sync-ui-fonts.mjs",
    "dev": "vite",
    "lint": "tsc --noEmit",
    "test:run": "vitest run",
    "build": "node scripts/sync-ui-fonts.mjs && tsc -b && vite build",
    "test:e2e": "playwright test",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-kr": "5.3.0",
    "@fontsource-variable/outfit": "5.3.0",
    "@radix-ui/react-select": "2.3.7",
    "@tanstack/react-query": "5.90.5",
    "echarts": "6.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@playwright/test": "1.56.1",
    "@redocly/cli": "2.51.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "jsdom": "29.0.0",
    "openapi-typescript-codegen": "0.31.0",
    "prettier": "3.6.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
