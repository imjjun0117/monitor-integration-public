{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.example/contracts/check-run.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "check_ids",
    "requested_by"
  ],
  "properties": {
    "check_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
      }
    },
    "requested_by": {
      "const": "monitor-center"
    }
  }
}
