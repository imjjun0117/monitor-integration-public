{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.example/contracts/agent-snapshot.schema.json",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "observed_at",
    "identity",
    "jvm",
    "system",
    "db_pools",
    "recent_checks",
    "partial",
    "collection_errors"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "identity": {
      "$ref": "#/$defs/identity"
    },
    "jvm": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "pid",
        "start_time",
        "uptime_ms",
        "java_vendor",
        "java_version",
        "process_cpu_ratio",
        "heap_used_bytes",
        "heap_max_bytes",
        "non_heap_used_bytes",
        "thread_live_count",
        "thread_peak_count",
        "gc_count",
        "gc_time_ms"
      ],
      "properties": {
        "pid": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "start_time": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "pattern": "Z$"
        },
        "uptime_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "java_vendor": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "java_version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "process_cpu_ratio": {
          "$ref": "#/$defs/nullableRatio"
        },
        "heap_used_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "heap_max_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "non_heap_used_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "thread_live_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "thread_peak_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "gc_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "gc_time_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "system_cpu_ratio",
        "physical_memory_used_bytes",
        "physical_memory_total_bytes",
        "disks"
      ],
      "properties": {
        "system_cpu_ratio": {
          "$ref": "#/$defs/nullableRatio"
        },
        "physical_memory_used_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "physical_memory_total_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "disks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path_id",
              "path_display",
              "used_bytes",
              "total_bytes"
            ],
            "properties": {
              "path_id": {
                "$ref": "#/$defs/id"
              },
              "path_display": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "used_bytes": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "total_bytes": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "db_pools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pool_id",
          "name",
          "active",
          "idle",
          "max",
          "min_idle",
          "waiters",
          "max_wait_ms",
          "validation_latency_ms",
          "unsupported"
        ],
        "properties": {
          "pool_id": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "active": {
            "$ref": "#/$defs/nullableCount"
          },
          "idle": {
            "$ref": "#/$defs/nullableCount"
          },
          "max": {
            "$ref": "#/$defs/nullableCount"
          },
          "min_idle": {
            "$ref": "#/$defs/nullableCount"
          },
          "waiters": {
            "$ref": "#/$defs/nullableCount"
          },
          "max_wait_ms": {
            "$ref": "#/$defs/nullableCount"
          },
          "validation_latency_ms": {
            "$ref": "#/$defs/nullableCount"
          },
          "unsupported": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "recent_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "category",
          "status",
          "duration_ms",
          "checked_at",
          "message"
        ],
        "properties": {
          "check_id": {
            "$ref": "#/$defs/id"
          },
          "category": {
            "enum": [
              "INTERNAL",
              "API"
            ]
          },
          "status": {
            "$ref": "#/$defs/status"
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0
          },
          "result_code": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 40
          },
          "checked_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "message": {
            "type": "string",
            "maxLength": 500
          },
          "http": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "method": {
                "enum": [
                  "GET",
                  "POST"
                ],
                "type": "string"
              },
              "url": {
                "maxLength": 8192,
                "type": "string"
              },
              "request_query": {
                "additionalProperties": {
                  "maxLength": 1024,
                  "type": "string"
                },
                "maxProperties": 32,
                "type": "object"
              },
              "request_headers": {
                "additionalProperties": {
                  "maxLength": 1024,
                  "type": "string"
                },
                "maxProperties": 32,
                "type": "object"
              },
              "request_body": {
                "maxLength": 4096,
                "type": [
                  "string",
                  "null"
                ]
              },
              "request_body_truncated": {
                "type": "boolean"
              },
              "connect_timeout_ms": {
                "minimum": 1,
                "type": "integer"
              },
              "read_timeout_ms": {
                "minimum": 1,
                "type": "integer"
              },
              "expected": {
                "maxLength": 2048,
                "type": "string"
              },
              "status_code": {
                "maximum": 599,
                "minimum": 100,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "response_headers": {
                "additionalProperties": {
                  "maxLength": 1024,
                  "type": "string"
                },
                "maxProperties": 32,
                "type": "object"
              },
              "response_body": {
                "maxLength": 4096,
                "type": [
                  "string",
                  "null"
                ]
              },
              "response_body_truncated": {
                "type": "boolean"
              },
              "response_bytes": {
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              }
            }
          },
          "details": {
            "additionalProperties": {
              "maxLength": 1024,
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            },
            "maxProperties": 32,
            "type": [
              "object",
              "null"
            ]
          }
        }
      }
    },
    "partial": {
      "type": "boolean"
    },
    "collection_errors": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 80
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "instance_id"
      ],
      "properties": {
        "project_id": {
          "$ref": "#/$defs/id"
        },
        "instance_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "nullableRatio": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "nullableCount": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "status": {
      "enum": [
        "UP",
        "WARN",
        "DOWN",
        "UNKNOWN"
      ]
    }
  }
}
