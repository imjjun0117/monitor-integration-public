{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.example/contracts/check-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "check_id",
    "category",
    "status",
    "duration_ms",
    "checked_at",
    "message"
  ],
  "properties": {
    "check_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
    },
    "category": {
      "enum": [
        "INTERNAL",
        "API"
      ]
    },
    "status": {
      "enum": [
        "UP",
        "WARN",
        "DOWN",
        "UNKNOWN"
      ]
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "result_code": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 40
    },
    "checked_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "message": {
      "type": "string",
      "maxLength": 500
    },
    "http": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "method": {
          "enum": [
            "GET",
            "POST"
          ],
          "type": "string"
        },
        "url": {
          "maxLength": 8192,
          "type": "string"
        },
        "request_query": {
          "additionalProperties": {
            "maxLength": 1024,
            "type": "string"
          },
          "maxProperties": 32,
          "type": "object"
        },
        "request_headers": {
          "additionalProperties": {
            "maxLength": 1024,
            "type": "string"
          },
          "maxProperties": 32,
          "type": "object"
        },
        "request_body": {
          "maxLength": 4096,
          "type": [
            "string",
            "null"
          ]
        },
        "request_body_truncated": {
          "type": "boolean"
        },
        "connect_timeout_ms": {
          "minimum": 1,
          "type": "integer"
        },
        "read_timeout_ms": {
          "minimum": 1,
          "type": "integer"
        },
        "expected": {
          "maxLength": 2048,
          "type": "string"
        },
        "status_code": {
          "maximum": 599,
          "minimum": 100,
          "type": [
            "integer",
            "null"
          ]
        },
        "response_headers": {
          "additionalProperties": {
            "maxLength": 1024,
            "type": "string"
          },
          "maxProperties": 32,
          "type": "object"
        },
        "response_body": {
          "maxLength": 4096,
          "type": [
            "string",
            "null"
          ]
        },
        "response_body_truncated": {
          "type": "boolean"
        },
        "response_bytes": {
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "details": {
      "additionalProperties": {
        "maxLength": 1024,
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      },
      "maxProperties": 32,
      "type": [
        "object",
        "null"
      ]
    }
  }
}
