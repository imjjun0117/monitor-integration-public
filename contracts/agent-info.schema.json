{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.example/contracts/agent-info.schema.json",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "agent_version",
    "observed_at",
    "identity",
    "attributes",
    "capabilities",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "agent_version": {
      "type": "string"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "instance_id"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
        },
        "instance_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
        }
      }
    },
    "attributes": {
      "type": "object",
      "additionalProperties": true,
      "required": ["display_name", "environment", "host_name", "context_path"],
      "properties": {
        "display_name": {"type": "string", "minLength": 1},
        "environment": {"type": "string"},
        "host_name": {"type": "string", "minLength": 1},
        "context_path": {"type": "string"}
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "enum": [
          "JVM",
          "SYSTEM",
          "DISK",
          "DB_POOL",
          "INTERNAL_CHECK",
          "API_CHECK"
        ]
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "name",
          "category",
          "direction"
        ],
        "properties": {
          "check_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "enum": [
              "INTERNAL",
              "API"
            ]
          },
          "direction": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "INTERNAL",
              "EXTERNAL",
              null
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {"category": {"const": "INTERNAL"}},
              "required": ["category"]
            },
            "then": {
              "properties": {"direction": {"type": "null"}}
            }
          },
          {
            "if": {
              "properties": {"category": {"const": "API"}},
              "required": ["category"]
            },
            "then": {
              "properties": {
                "direction": {"enum": ["INTERNAL", "EXTERNAL"]}
              }
            }
          }
        ]
      }
    }
  }
}
